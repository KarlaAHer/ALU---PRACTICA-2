module top (
    input wire [4:0] A,
    input wire [4:0] B,
    input wire [1:0] sel,
    output wire [6:0] HEX0,
    output wire [6:0] HEX1,
    output wire [6:0] HEX2,
    output wire LED_signo
);

wire [9:0] result;
wire error;
wire [9:0] magnitud;
wire [8:0] bin_abs;
wire [3:0] centenas, decenas, unidades;
wire [6:0] seg0, seg1, seg2;

alu ALU (.A(A), .B(B), .sel(sel), .Y(result), .error(error));

assign LED_signo = (~error) & result[9];

assign magnitud = result[9] ? (~result + 10'd1) : result;
assign bin_abs = magnitud[8:0];

bin_to_BCD BCD (.bin(bin_abs), .hund(centenas), .tens(decenas), .ones(unidades));

deco D0 (.digit(unidades), .seg(seg0));
deco D1 (.digit(decenas), .seg(seg1));
deco D2 (.digit(centenas), .seg(seg2));

assign HEX0 = error ? 7'b0111111 : seg0;
assign HEX1 = error ? 7'b0111111 : seg1;
assign HEX2 = error ? 7'b0111111 : seg2;

endmodule
